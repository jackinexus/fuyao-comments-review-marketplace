{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "fuyao-comments-review",
  "version": "0.1.4",
  "description": "Generate auditable Instagram and TikTok comment-section review reports.",
  "author": {
    "name": "Jack Wu"
  },
  "homepage": "https://www.fuyaomktmate.top/comments-review",
  "license": "Proprietary",
  "keywords": [
    "comments",
    "instagram",
    "tiktok",
    "review"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/fuyao-comments-review-setup/SKILL.md",
      "interface": {
        "displayName": "Fuyao Comments Review",
        "shortDescription": "Instagram 与 TikTok 评论区复盘",
        "longDescription": "复盘 Instagram Reel 和 TikTok 视频的评论区。插件会采集评论与回复、核对覆盖率，并在 Codex 中结合视频内容逐条审核，生成包含关键发现和评论依据的 Word 报告。首次使用需完成 Fuyao 登录并开通权限。",
        "developerName": "Jack Wu",
        "category": "Productivity",
        "capabilities": [
          "Marketing"
        ],
        "websiteURL": "https://www.fuyaomktmate.top/comments-review",
        "defaultPrompt": [
          "请复盘这条 Instagram Reel 或 TikTok 视频的评论区，并生成报告。视频链接：<视频链接>"
        ],
        "brandColor": "#1F5A66",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg"
      }
    }
  }
}
